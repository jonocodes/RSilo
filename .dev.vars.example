# Copy this file to .dev.vars and fill in values for local `wrangler dev`.
# For offline dev (bun run dev:offline), set these as shell env vars instead.

# Required in production: signs file manager and OAuth session cookies.
SESSION_SECRET=change-me-to-a-random-string

# Required in production: protects /admin/* endpoints.
ADMIN_SECRET=change-me-to-a-different-random-string

# Required in production: verifies signed JWT access tokens.
JWT_SECRET=change-me-to-another-random-string

# Optional maximum object size in bytes (defaults to 10 MiB).
MAX_OBJECT_SIZE_BYTES=10485760

# Local development only. Allows fallback sessions, open admin access when
# ADMIN_SECRET is blank, and unsigned test tokens when JWT_SECRET is blank.
RSILO_DEV_MODE=true
