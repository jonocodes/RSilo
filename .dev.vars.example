# Copy this file to .dev.vars and fill in values for local `wrangler dev`.
# For offline dev (bun run dev:offline), set these as shell env vars instead.

# OWNER_EMAIL (the only identity allowed into /account) is the one setting
# required in production. ACCOUNT_USERNAME (production default "me") and
# PUBLIC_BASE_URL (production default: the request's origin) are optional.
# In dev mode all three default to the values below, so these lines are
# optional locally.
ACCOUNT_USERNAME=alice
OWNER_EMAIL=alice@example.com
PUBLIC_BASE_URL=http://localhost:8787

# Optional maximum object size in bytes (defaults to 10 MiB).
MAX_OBJECT_SIZE_BYTES=10485760

# Optional: keep files in an S3-compatible bucket (e.g. a local SeaweedFS: see test/s3-live.test.ts) instead
# of the local R2 simulation. All but S3_REGION are required once any is set.
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_BUCKET=rsilo-dev
# S3_ACCESS_KEY_ID=rsiloadmin
# S3_SECRET_ACCESS_KEY=rsilo-secret-123

# Local development only. Signs requests to localhost in as a dev identity when
# Cloudflare Access is absent, and enables /debug/*. RSILO_DEV_EMAIL (default:
# OWNER_EMAIL) sets that identity's email, e.g. to preview the "not allowed" page.
RSILO_DEV_MODE=true
# RSILO_DEV_EMAIL=someone-else@example.com
