{
  "name": "rsilo",
  "version": "0.3.0",
  "description": "RSilo - RemoteStorage server for Cloudflare Workers + R2 + D1",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:offline": "bun --watch src/server-offline.ts",
    "dev-token": "bun run src/scripts/dev-token.ts",
    "setup": "bun run src/scripts/setup.ts",
    "db:setup:local": "bun run src/scripts/setup-local-db.ts",
    "deploy": "bun run src/scripts/deploy.ts",
    "docs:api": "bun run src/scripts/render-api-docs.ts",
    "docs:api:check": "bun run src/scripts/render-api-docs.ts --check",
    "docs:screenshots": "bun run src/scripts/screenshots.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "eslint src test --fix",
    "lint:prune": "eslint src test --prune-suppressions",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun run src/scripts/deploy.ts --migrate-only"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.6.0",
    "eslint": "^9.24.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.18"
  },
  "cloudflare": {
    "bindings": {
      "OWNER_EMAIL": {
        "description": "Your email address, the only setting RSilo needs. Only this email may open `/account`; allow the same email in the Cloudflare Access policy (see https://github.com/jonocodes/RSilo/blob/main/docs/self-hosting.md#set-up-cloudflare-access). Your storage address will be `me@<your Worker's host>`."
      }
    }
  }
}
